---
interface Props {
  benefits: string[];
  accentColor: string;
}

const { benefits, accentColor } = Astro.props;
---

{benefits.length > 0 && (
  <section>
    <h2>What you get</h2>
    <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem;">
      {benefits.map((benefit) => (
        <li style={`background: #fff; border-left: 3px solid ${accentColor}; border-radius: 4px; padding: 1rem 1.25rem; font-size: 0.95rem; line-height: 1.5;`}>
          {benefit}
        </li>
      ))}
    </ul>
  </section>
)}
