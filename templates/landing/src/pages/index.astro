---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PainPoints from "../components/PainPoints.astro";
import Benefits from "../components/Benefits.astro";
import SignupForm from "../components/SignupForm.astro";
import experiment from "../../experiment.json";
---

<Base title={experiment.headline} accentColor={experiment.accent_color}>
  <Hero
    headline={experiment.headline}
    subheadline={experiment.subheadline}
    oneLiner={experiment.one_liner}
    productType={experiment.product_type}
  />
  <PainPoints painPoints={experiment.pain_points} />
  <Benefits benefits={experiment.benefits} accentColor={experiment.accent_color} />
  <SignupForm
    apiUrl={experiment.api_url}
    experimentId={experiment.id}
    productType={experiment.product_type}
  />
</Base>
