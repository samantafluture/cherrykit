FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate
WORKDIR /app

# Install dependencies (with native module build tools for better-sqlite3)
FROM base AS deps
RUN apk add --no-cache python3 make g++
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Build TypeScript
FROM deps AS build
COPY tsconfig.json ./
COPY src/ ./src/
RUN pnpm exec tsc --noEmit

# Production dependencies only
FROM base AS deps-prod
RUN apk add --no-cache python3 make g++
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

# Install Astro template dependencies
FROM base AS template-deps
COPY templates/landing/package.json templates/landing/pnpm-lock.yaml* ./templates/landing/
RUN cd templates/landing && pnpm install --frozen-lockfile || pnpm install

# Final image
FROM node:22-alpine AS api
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate
WORKDIR /app

COPY --from=deps-prod /app/node_modules ./node_modules
COPY --from=template-deps /app/templates/landing/node_modules ./templates/landing/node_modules
COPY package.json tsconfig.json ./
COPY src/ ./src/
COPY templates/ ./templates/

# Install tsx for runtime TypeScript execution
RUN pnpm add -D tsx

# Create data and dist directories
RUN mkdir -p /app/data /app/dist

# chown to 1001:1001 matching VPS host sam — docker-compose user: overrides USER
# Also fix corepack cache — built as root, needs to be readable by runtime UID
RUN chown -R 1001:1001 /app/data /app/dist /.cache

USER node

EXPOSE 3848

CMD ["pnpm", "api"]
