# CherryKit Production Environment
# Copy to .env and fill in values: cp .env.production.example .env

# API
PORT=3848
NODE_ENV=production

# CORS — allowed origins for landing page form submissions
CORS_ORIGINS=https://validate.samantafluture.com

# Database (SQLite — path is relative to /app inside container)
DATABASE_PATH=data/rvk.db
